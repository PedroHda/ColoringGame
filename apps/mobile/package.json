{
  "name": "@colore/mobile",
  "version": "6.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "npm run prebuild:android && expo run:android",
    "assets": "node scripts/sync-assets.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "bundle:android": "npm run assets && expo export --platform android --output-dir build-bundle",
    "build:development": "eas build --platform android --profile development",
    "build:apk": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "prebuild:android": "npm run assets && node scripts/prebuild.mjs",
    "eas-build-post-install": "npm run assets"
  },
  "dependencies": {
    "@react-native-community/slider": "5.1.2",
    "@shopify/react-native-skia": "2.4.18",
    "expo": "~55.0.32",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-dev-client": "~55.0.41",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-haptics": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-speech": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@types/react": "~19.2.0",
    "tsx": "~4.21.0",
    "typescript": "~5.9.2"
  }
}
